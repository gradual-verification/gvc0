#use <conio>
#use <string>
#use <util>

int runtime_hash(int index, int arrayLength)
    //@requires index >= 0;
    //@ensures \result >= 0 && \result < arrayLength;
{
  index = ((index >> 16) ^ index) * 0x45d9f3b;
  index = ((index >> 16) ^ index) * 0x45d9f3b;
  index = (index >> 16) ^ index;
  return index % arrayLength;
}

int runtime_gcd(int a, int b)
  //@ensures \result >= 1;
{
  if (a < 0) a = -a;
  if (b < 0) b = -b;

  while (b != 0) {
    int t = b;
    b = a % b;
    a = t;
  }

  return a == 0 ? 1 : a;
}

bool runtime_mulOverflows(int a, int b)
  //@requires a >= 0 && b >= 0;
{
  if (a == 0 || b == 0) return false;
  return a > int_max() / b;
}

bool runtime_addOverflows(int a, int b)
  //@requires a >= 0 && b >= 0;
{
  return a > int_max() - b;
}

OwnedFields* runtime_init(){
  OwnedFields* fields = alloc(OwnedFields);
  fields->capacity = 128;
  fields->contents = alloc_array(FieldArray*, fields->capacity);
  return fields;
}

int runtime_compact(FieldArray*[] contents, int capacity, int newId) {
  // Find first NULL
  int start = 0;
  while (contents[start] != NULL)
    start++;

  int removed = 0;
  int insert = start;
  int i = start + 1;
  while (i != start) {
    FieldArray* entry = contents[i];
    if (entry == NULL) {
      // skip
    } else if (entry->accessible == 0 && entry->id != newId) {
      removed++;
    } else {
      if (insert != i) {
        int psl = entry->psl;
        // Calculate the distance between `insert` and `i`
        // Allow `i` to wrap around before `insert` does
        int distance = insert <= i ? i - insert : capacity + i - insert;
        if (psl < distance) {
          // Only move up to `psl` spots backwards, otherwise it would be prior
          // to the hash location
          int newInsert = (insert + distance - psl) % capacity;
          while (insert != newInsert) {
            contents[insert] = NULL;
            insert = (insert + 1) % capacity;
          }

          distance = psl;
        }

        if (distance != 0) {
          contents[insert] = entry;
          entry->psl -= distance;
        }
        
      }

      insert = (insert + 1) % capacity;
    }

    i = (i + 1) % capacity;
  }

  // `i == start`
  // NULL all locations from `insert` up to `start` (which is already NULL)
  while (insert != i) {
    contents[insert] = NULL;
    insert = (insert + 1) % capacity;
  }

  return removed;
}

// Called whenever a new element is added. Increments the `length` and resizes
// the backing array whenever necessary.
// `newIndex` specifies an index that will not be dropped, even if no fields in
// it are accessible (i.e., if it has just been added to the array).
void runtime_grow(OwnedFields* fields, int newId)
{
  int newLength = fields->length + 1;
  fields->length = newLength;

  // Keep the hash table's "load factor" under 80%
  // I.e., length is always < 80% of capacity
  int capacity = fields->capacity;
  if (newLength * 5 >= capacity * 4) {
    int GROW_CONST = 128;
    FieldArray*[] contents = fields->contents;

    // Check if we can gain enough space just by dropping unused entries
    int unused = runtime_compact(contents, capacity, newId);
    if (unused != 0) {
      fields->length -= unused;
      if (unused >= GROW_CONST)
        return;
    }
    
    // Otherwise, use a larger array and rehash
    int newCapacity = capacity + GROW_CONST;
    fields->capacity = newCapacity;

    FieldArray*[] newContents = alloc_array(FieldArray*, newCapacity);
    fields->contents = newContents;

    // Add all items into the new array
    for (int i = 0; i < capacity; i++) {
      FieldArray* entry = contents[i];
      if (entry != NULL) {
        int k = runtime_hash(entry->id, newCapacity);
        int psl = 0;
        while (newContents[k] != NULL) {
          FieldArray* existing = newContents[k];
          if (psl > existing->psl) {
            entry->psl = psl;
            psl = existing->psl;

            newContents[k] = entry;
            entry = existing;
          }

          k = (k + 1) % newCapacity;
          psl++;
        }
        newContents[k] = entry;
        entry->psl = psl;
      }
    }
  }
}

FieldArray* runtime_find(OwnedFields* fields, int id) {
  if (id >= 0) {
    FieldArray*[] contents = fields->contents;
    int capacity = fields->capacity;
    int index = runtime_hash(id, capacity);
    int psl = 0;
    while (true) {
      FieldArray* entry = contents[index];
      if (entry == NULL || entry->psl < psl)
        return NULL;
      else if (entry->id == id)
        return entry;
      else
        index = (index + 1) % capacity;
      psl++;
    }
  }

  return NULL;
}

// Add a new field array with the specified reference ID
// NOTE: This assumes that no field with the same reference ID have been added
FieldArray* runtime_newFieldArray(OwnedFields* fields, int id, int numFields) {
  FieldArray*[] contents = fields->contents;
  int capacity = fields->capacity;
  int index = runtime_hash(id, capacity);
  int psl = 0;
  FieldArray* current = NULL;
  FieldArray* newEntry = NULL;

  while (contents[index] != NULL) {
    FieldArray* entry = contents[index];
    if (entry->accessible == 0) {
      if (current == NULL) {
        entry->id = id;
        if (entry->length < numFields) {
          entry->permNum = alloc_array(int, numFields);
          entry->permDenom = alloc_array(int, numFields);
          for (int k = 0; k < numFields; k++) {
            entry->permDenom[k] = 1;
          }
          entry->length = numFields;
        }

        current = entry;
        newEntry = entry;
      }

      entry = contents[(index + 1) % capacity];
      while (entry != NULL && psl < entry->psl) {
        entry->psl--;
        contents[index] = entry;
        index = (index + 1) % capacity;
        entry = contents[(index + 1) % capacity];
        psl++;
      }

      current->psl = psl;
      contents[index] = current;
      return newEntry;
    }

    // Robin-hood hashing: For any i, the values that hash to bucket i precede
    // the values that hash to bucket i+1
    // https://www.cs.cornell.edu/courses/JavaAndDS/files/hashing_RobinHood.pdf
    if (psl > entry->psl) {
      // If the current PSL is longer than this PSL, we replace this one with
      // the new item, and then "re-insert" the item we just replaced

      if (current == NULL) {
        newEntry = alloc(FieldArray);
        newEntry->id = id;
        newEntry->length = numFields;
        newEntry->permNum = alloc_array(int, numFields);
        newEntry->permDenom = alloc_array(int, numFields);
        for (int k = 0; k < numFields; k++) {
          newEntry->permDenom[k] = 1;
        }
        current = newEntry;
      }

      // Swap psl and contents[index]->psl
      current->psl = psl;
      psl = entry->psl;

      // Swap current and contents[index]
      contents[index] = current;
      current = entry;

      // Continue inserting `entry`
    }

    index = (index + 1) % capacity;
    psl++;
  }

  if (current == NULL) {
    newEntry = alloc(FieldArray);
    newEntry->id = id;
    newEntry->length = numFields;
    newEntry->permNum = alloc_array(int, numFields);
    newEntry->permDenom = alloc_array(int, numFields);
    for (int k = 0; k < numFields; k++) {
      newEntry->permDenom[k] = 1;
    }
    current = newEntry;
  }

  contents[index] = current;
  current->psl = psl;
  runtime_grow(fields, id);
  return newEntry;
}

// Adds a new FieldArray that fully owns its fields
// NOTE: This assumes that no field with the same reference ID have been added
void runtime_addAll(OwnedFields* fields, int id, int numFields) {
  if (fields == NULL) return;

  // Reuse the entry if one already exists with that ID
  // Cannot let a duplicate (unused) entry exist with the same ID
  FieldArray* entry = runtime_find(fields, id);
  if (entry == NULL)
    entry = runtime_newFieldArray(fields, id, numFields);
  int[] permNum = entry->permNum;
  int[] permDenom = entry->permDenom;
  for (int i = 0; i < numFields; i++){
    permNum[i] = 1;
    permDenom[i] = 1;
  }
  entry->accessible = numFields;
}

// Adds the specified permission (id, fieldIndex, permNum/permDenom) to the
// set of permissions. Returns false (without modifying anything) if doing so
// would cause the held permission to exceed full (1/1); otherwise commits the
// addition and returns true.
bool runtime_tryAdd(OwnedFields* fields, int id, int numFields, int fieldIndex, int permNum, int permDenom) {
  FieldArray* entry = runtime_find(fields, id);
  if (entry == NULL) {
    entry = runtime_newFieldArray(fields, id, numFields);
  }

  int heldNum = entry->permNum[fieldIndex];
  int heldDenom = entry->permDenom[fieldIndex];

  if (runtime_mulOverflows(heldNum, permDenom) ||
      runtime_mulOverflows(permNum, heldDenom) ||
      runtime_mulOverflows(heldDenom, permDenom)) {
    return false;
  }

  int left = heldNum * permDenom;
  int right = permNum * heldDenom;
  if (runtime_addOverflows(left, right)) {
    return false;
  }

  int newNum = left + right;
  int newDenom = heldDenom * permDenom;

  // Cannot have num greater than the denom
  if (newNum > newDenom) {
    return false;
  }

  // Reduce fraction if possible
  int g = runtime_gcd(newNum, newDenom);
  entry->permNum[fieldIndex] = newNum / g;
  entry->permDenom[fieldIndex] = newDenom / g;

  // update count of the number of non-zero fields
  if (heldNum == 0 && newNum != 0) {
    entry->accessible++;
  }

  return true;
}

// Adds the specified permission (id, fieldIndex, permNum/permDenom) to the
// set of permissions. Throws `errorMessage` if doing so would cause the held
// permission to exceed full (1/1).
void runtime_add(OwnedFields* fields, int id, int numFields, int fieldIndex, int permNum, int permDenom, string errorMessage) {
  if (!runtime_tryAdd(fields, id, numFields, fieldIndex, permNum, permDenom))
    error(errorMessage);
}

// Assert that at least permNum/permDenom of the permission (id, fieldIndex)
// is held, otherwise throws `errorMessage`
void runtime_assert(OwnedFields* fields, int id, int fieldIndex, int permNum, int permDenom, string errorMessage) {
  FieldArray* entry = runtime_find(fields, id);
  int heldNum = entry == NULL ? 0 : entry->permNum[fieldIndex];
  int heldDenom = entry == NULL ? 1 : entry->permDenom[fieldIndex];

  if (runtime_mulOverflows(heldNum, permDenom) || runtime_mulOverflows(permNum, heldDenom)) {
    error(errorMessage);
  }

  // Rearranged check from heldNum / heldDenom < permNum / permDenom
  if (heldNum * permDenom < permNum * heldDenom) {
    error(errorMessage);
  }
}

// Assert that any nonzero permission exist
void runtime_assertAny(OwnedFields* fields, int id, int fieldIndex, string errorMessage) {
  FieldArray* entry = runtime_find(fields, id);
  int heldNum = entry == NULL ? 0 : entry->permNum[fieldIndex];
  int heldDenom = entry == NULL ? 1 : entry->permDenom[fieldIndex];

  if (heldNum <= 0) {
    error(errorMessage);
  }

  // Defensive check, should already be valid
  if (heldNum > heldDenom) {
    error(errorMessage);
  }
}

// Removes the specified permission from the 
// set of permissions. Returns false (without 
// modifying anything) if less than permNum/permDenom
// is currently held; otherwise commits the removal and
// returns true.
bool runtime_tryRemove(OwnedFields* fields, int id, int fieldIndex, int permNum, int permDenom) {
  FieldArray* entry = runtime_find(fields, id);
  if (entry == NULL) {
    return false;
  }

  int heldNum = entry->permNum[fieldIndex];
  int heldDenom = entry->permDenom[fieldIndex];

  if (runtime_mulOverflows(heldNum, permDenom) ||
      runtime_mulOverflows(permNum, heldDenom) ||
      runtime_mulOverflows(heldDenom, permDenom)) {
    return false;
  }

  // heldNum / heldDenom < permNum / permDenom
  int left = heldNum * permDenom;
  int right = permNum * heldDenom;
  int diffDenom = heldDenom * permDenom;

  // Cannot go negative
  if (left < right) {
    return false;
  }
  
  int diffNum = left - right;

  int g = runtime_gcd(diffNum, diffDenom);
  entry->permNum[fieldIndex] = diffNum / g;
  entry->permDenom[fieldIndex] = diffDenom / g;

  if (heldNum != 0 && diffNum == 0) {
    entry->accessible--;
  }

  return true;
}

// Removes the permission (id, fieldIndex, permNum/permDenom) from the set of
// permissions. Throws `errorMessage` if less than permNum/permDenom is
// currently held.
void runtime_remove(OwnedFields* fields, int id, int fieldIndex, int permNum, int permDenom, string errorMessage) {
  if (!runtime_tryRemove(fields, id, fieldIndex, permNum, permDenom))
    error(errorMessage);
}

void runtime_join(OwnedFields* target, OwnedFields* source, string errorMessage) {
  if (target == NULL || source == NULL)
    return;

  int sourceCapacity = source->capacity;
  FieldArray*[] sourceContents = source->contents;

  // First pass: verify every field's combined permission <= (1/1) permission
  for (int i = 0; i < sourceCapacity; i++) {
    FieldArray* sourceEntry = sourceContents[i];
    if (sourceEntry != NULL && sourceEntry->accessible != 0) {
      int id = sourceEntry->id;
      FieldArray* targetEntry = runtime_find(target, id);
      int length = sourceEntry->length;
      int[] sn = sourceEntry->permNum;
      int[] sd = sourceEntry->permDenom;

      // each entry has a permissions array,
      // with each slot representing a field's
      // individual permission
      for (int j = 0; j < length; j++) {
        // targetEntry's jth fields += sourceEntry's jth field
        if (sn[j] != 0) {
          int heldNum = targetEntry == NULL ? 0 : targetEntry->permNum[j];
          int heldDenom = targetEntry == NULL ? 1 : targetEntry->permDenom[j];

          if (runtime_mulOverflows(heldNum, sd[j]) ||
              runtime_mulOverflows(sn[j], heldDenom) ||
              runtime_mulOverflows(heldDenom, sd[j])) {
            error(errorMessage);
          }

          int left = heldNum * sd[j];
          int right = sn[j] * heldDenom;
          if (runtime_addOverflows(left, right)) {
            error(errorMessage);
          }

          int newNum = left + right;
          int newDenom = heldDenom * sd[j];
          if (newNum > newDenom) {
            error(errorMessage);
          }
        }
      }
    }
  }

  // Now commit 
  for (int i = 0; i < sourceCapacity; i++) {
    FieldArray* sourceEntry = sourceContents[i];
    if (sourceEntry != NULL && sourceEntry->accessible != 0) {
      int id = sourceEntry->id;
      FieldArray* targetEntry = runtime_find(target, id);
      if (targetEntry == NULL)
        targetEntry = runtime_newFieldArray(target, id, sourceEntry->length);

      // Assume that they both have the same length
      int length = sourceEntry->length;
      int[] sn = sourceEntry->permNum;
      int[] sd = sourceEntry->permDenom;
      int[] tn = targetEntry->permNum;
      int[] td = targetEntry->permDenom;

      for (int j = 0; j < length; j++) {
        if (sn[j] != 0) {
          int heldNum = tn[j];
          int heldDenom = td[j];
          int newNum = heldNum * sd[j] + sn[j] * heldDenom;
          int newDenom = heldDenom * sd[j];
          int g = runtime_gcd(newNum, newDenom);

          if (heldNum == 0) {
            targetEntry->accessible++;
          }

          tn[j] = newNum / g;
          td[j] = newDenom / g;
        }
      }
    }
  }
}

void runtime_print(OwnedFields* fields) {
  if (fields != NULL) {
    print("{ ");

    bool first = true;
    for (int i = 0; i < fields->capacity; i++) {
      FieldArray* entry = fields->contents[i];
      if (entry != NULL) {
        if (first) first = false;
        else print(", ");

        printf("%d@%d#%d+%d:", entry->id, i, runtime_hash(entry->id, fields->capacity), entry->psl);
        for (int j = 0; j < entry->length; j++) {
          if (j != 0) print(",");
          if (entry->permNum[j] == 0) {
            print("_");
          } else {
            printf("%d/%d", entry->permNum[j], entry->permDenom[j]);
          }
        }
      }
    }

    printf(" } (%d of %d)\n", fields->length, fields->capacity);
  } else {
    println("OwnedFields is empty/NULL");
  }
}