method main() returns ($result: Int)
  requires true
  ensures true
{
  var _: Int
  _ := test(3)
  $result := _
}

method test(n: Int) returns ($result: Int)
  requires (n >= 0 ? (forall i: Int :: 0 <= i && i < n ==> i >= 0) : true)
  ensures (forall i: Int :: 0 <= i && i < n ==> (i > 0 ? true : i == 0))
{
  $result := 0
}