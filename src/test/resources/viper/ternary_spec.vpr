method main() returns ($result: Int)
  requires true
  ensures true
{
  var _: Int
  _ := test(1, 2, 0)
  $result := _
}

method test(x: Int, y: Int, z: Int) returns ($result: Int)
  requires ? && true
  ensures (x > 0 ? y > 0 : z == 0) && true
{
  $result := 0
}

method testAndPrecedence(a: Int, b: Int, c: Int, d: Int)
  returns ($result: Int)
  requires ? && true
  ensures (a > 0 && b > 0 ? c > 0 : d == 0) && true
{
  $result := 0
}

method testOrPrecedence(a: Int, b: Int, c: Int, d: Int)
  returns ($result: Int)
  requires ? && true
  ensures (a > 0 || b > 0 ? c > 0 : d == 0) && true
{
  $result := 0
}