field node$value: Int

method main() returns ($result: Int)
  requires true
  ensures true
{
  $result := 0
}

method test(x: Ref, n: Int, flag: Bool) returns ($result: Int)
  requires n > 0 &&
    (n > 2 ? acc(x.node$value, 1 / n) : acc(x.node$value, 1 / 2))
  ensures n > 0 ==> (forall i: Int ::0 <= i && i < n ==> i >= 0)
{
  var a: Array[Int]
  a := Array[Int](2)
  a[0] := 0
  a[1] := 1
  $result := a[0]
}