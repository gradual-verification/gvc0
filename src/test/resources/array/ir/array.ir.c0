int alloc_array_bool();
int alloc_array_char();
int alloc_array_int();
int main();

int alloc_array_bool()
  //@requires true;
  //@ensures true;
{
  bool[] b;
  b = alloc_array(bool, 5);
  b[1] = true;
  return 0;
}

int alloc_array_char()
  //@requires true;
  //@ensures true;
{
  char[] c;
  c = alloc_array(char, 7);
  c[2] = 'x';
  return 0;
}

int alloc_array_int()
  //@requires true;
  //@ensures true;
{
  int[] a;
  a = alloc_array(int, 3);
  a[0] = 1;
  return 0;
}

int main()
  //@requires true;
  //@ensures true;
{
  int _ = 0;
  int _1 = 0;
  int _2 = 0;
  _ = alloc_array_int();
  _1 = alloc_array_bool();
  _2 = alloc_array_char();
  return 0;
}
